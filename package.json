{
  "name": "counter",
  "version": "0.1.0",
  "private": true,
  "description": "A local caf\u00e9 co-pilot: ask your business a question, get an answer in real numbers, and approve any action before it runs.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
